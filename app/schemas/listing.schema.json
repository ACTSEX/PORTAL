{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.acts.example/schemas/v1/listing.schema.json",
  "title": "Listing",
  "description": "Version 1 contract for an ACTS real-estate listing.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 16, "maxLength": 64 },
    "ownerId": { "type": "string", "minLength": 16, "maxLength": 64 },
    "categoryId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 120 },
    "title": { "type": "string", "minLength": 5, "maxLength": 160 },
    "description": { "type": "string", "minLength": 20, "maxLength": 10000 },
    "listingType": { "type": "string", "enum": ["sale", "rent"] },
    "status": { "type": "string", "enum": ["draft", "pending", "published", "archived", "deleted"] },
    "priceMinor": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "region": { "type": "string", "minLength": 2, "maxLength": 120 },
        "city": { "type": "string", "minLength": 2, "maxLength": 120 },
        "district": { "type": "string", "maxLength": 120 },
        "addressLine": { "type": "string", "maxLength": 240 },
        "postalCode": { "type": "string", "maxLength": 20 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "required": ["countryCode", "region", "city"]
    },
    "attributes": { "type": "object", "maxProperties": 100 },
    "publishedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "ownerId", "categoryId", "slug", "title", "description", "listingType", "status", "priceMinor", "currency", "location", "attributes"]
}
