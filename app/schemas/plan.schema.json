{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.acts.example/schemas/v1/plan.schema.json",
  "title": "Plan",
  "description": "Version 1 plan limits, features and billing representation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "code": { "type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$", "minLength": 2, "maxLength": 64 },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000 },
    "priceMinor": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "billingInterval": { "type": "string", "enum": ["month", "year"] },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listings": { "type": "integer", "minimum": 0 },
        "media": { "type": "integer", "minimum": 0 }
      },
      "required": ["listings", "media"]
    },
    "features": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" } },
    "active": { "type": "boolean" }
  },
  "required": ["id", "code", "name", "priceMinor", "currency", "billingInterval", "limits", "features", "active"]
}
