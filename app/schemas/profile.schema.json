{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.acts.example/schemas/v1/profile.schema.json",
  "title": "Profile",
  "description": "Version 1 public profile for a user, professional or company.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "userId": { "type": "string", "minLength": 16, "maxLength": 64 },
    "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
    "bio": { "type": "string", "maxLength": 2000 },
    "phone": { "type": "string", "pattern": "^\\+?[0-9 ()-]{8,32}$" },
    "avatarR2Key": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000-\\u001F]{1,512}$" },
    "websiteUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
    "professional": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registrationNumber": { "type": "string", "minLength": 2, "maxLength": 40 },
        "registrationRegion": { "type": "string", "minLength": 2, "maxLength": 20 },
        "companyName": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["pending", "verified", "suspended"] }
      },
      "required": ["registrationNumber", "registrationRegion", "status"]
    },
    "socialLinks": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri", "maxLength": 2048 },
      "maxProperties": 12,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{1,31}$" }
    }
  },
  "required": ["userId", "displayName", "socialLinks"]
}
