{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.acts.example/schemas/v1/user.schema.json",
  "title": "User",
  "description": "Version 1 public-safe user and authorization contract; authentication secrets are excluded.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 16, "maxLength": 64 },
    "email": { "type": "string", "format": "email", "maxLength": 254 },
    "role": { "type": "string", "enum": ["user", "professional", "admin"] },
    "status": { "type": "string", "enum": ["pending", "active", "suspended", "deleted"] },
    "permissions": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.:_-][a-z0-9]+)*$", "maxLength": 80 } },
    "emailVerifiedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "email", "role", "status", "permissions", "createdAt", "updatedAt"]
}
