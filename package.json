{
  "name": "portal-v2",
  "version": "2.0.0-rodada.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "validate:config": "node scripts/validate-config.mjs",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run validate:config && npm run validate:architecture && npm test && npm run build",
    "dry-run": "wrangler deploy --dry-run --outdir dist/worker-dry-run",
    "audit:v2": "node scripts/audit-v2.mjs",
    "test:integration": "node --test tests/integration-v2.test.js",
    "test:security": "node --test tests/security.test.js tests/asaas.test.js",
    "test:public": "node --test tests/rodada4.test.js tests/performance.test.js",
    "test:workflows": "node --test tests/workflows.test.js",
    "bootstrap:r2": "node scripts/bootstrap-r2.mjs check",
    "migrate:check": "node scripts/validar-v1.mjs check"
  },
  "devDependencies": {}
}
