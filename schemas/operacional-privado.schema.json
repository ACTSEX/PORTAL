{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.local/schemas/operacional-privado.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "clienteId",
    "cidadePrincipal",
    "cidadesAtendimento",
    "diretorio",
    "status",
    "contato",
    "endereco"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "clienteId": {
      "type": "string"
    },
    "cidadePrincipal": {
      "type": "string"
    },
    "cidadesAtendimento": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1
    },
    "diretorio": {
      "enum": [
        "mulheres",
        "homens",
        "transex"
      ]
    },
    "status": {
      "type": "string"
    },
    "contato": {
      "type": "object"
    },
    "endereco": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
