{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.local/schemas/perfil-publico.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "clienteId",
    "slug",
    "nomeArtistico",
    "idade",
    "diretorio",
    "cidadePrincipal",
    "cidadesAtendimento",
    "categorias",
    "midiasManifesto"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "clienteId": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "nomeArtistico": {
      "type": "string"
    },
    "idade": {
      "type": "integer",
      "minimum": 18
    },
    "diretorio": {
      "enum": [
        "mulheres",
        "homens",
        "transex"
      ]
    },
    "cidadePrincipal": {
      "type": "string"
    },
    "cidadesAtendimento": {
      "type": "array",
      "maxItems": 1
    },
    "categorias": {
      "type": "array"
    },
    "midiasManifesto": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
