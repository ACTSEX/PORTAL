{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.local/schemas/config-categorias.schema.json",
  "type": "object",
  "required": [
    "versao",
    "status",
    "porDiretorio"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "status": {
      "type": "string"
    },
    "porDiretorio": {
      "type": "object",
      "required": [
        "mulheres",
        "homens",
        "transex"
      ]
    }
  },
  "additionalProperties": false
}
