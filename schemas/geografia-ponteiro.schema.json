{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "versaoCatalogo",
    "base",
    "manifesto",
    "atualizadoEm"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "versaoCatalogo": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "base": {
      "type": "string",
      "pattern": "^versoes/[a-z0-9][a-z0-9._-]+/$"
    },
    "manifesto": {
      "type": "string",
      "pattern": "^versoes/[a-z0-9][a-z0-9._-]+/manifesto\\.json$"
    },
    "atualizadoEm": {
      "type": "string",
      "format": "date-time"
    }
  }
}
