{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicationId",
    "atualizadoEm",
    "cidades"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "publicationId": {
      "type": "string",
      "minLength": 1
    },
    "atualizadoEm": {
      "type": "string",
      "format": "date-time"
    },
    "cidades": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paisId",
          "estadoId",
          "estadoSigla",
          "municipioId",
          "nome",
          "slug",
          "quantidadeAnuncios",
          "diretorios"
        ],
        "properties": {
          "paisId": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "estadoId": {
            "type": "integer",
            "minimum": 1
          },
          "estadoSigla": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "municipioId": {
            "type": "integer",
            "minimum": 1000000,
            "maximum": 9999999
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^(?!.*[<>]).+$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "quantidadeAnuncios": {
            "type": "integer",
            "minimum": 1
          },
          "diretorios": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mulheres",
              "homens",
              "transex"
            ],
            "properties": {
              "mulheres": {
                "type": "integer",
                "minimum": 0
              },
              "homens": {
                "type": "integer",
                "minimum": 0
              },
              "transex": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
